# FactoryLM Foreman Slack Bot Configuration

# Required: Bot token from https://api.slack.com/apps (starts with xoxb-)
FOREMAN_SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Required: App-level token for Socket Mode (starts with xapp-)
FOREMAN_SLACK_APP_TOKEN=xapp-your-app-token-here

# Optional: Bot's user ID for validation (format: U0ABCDEF123)
FOREMAN_SLACK_BOT_USER_ID=

# Optional: Channel to monitor (default: factorylm-foreman)
FOREMAN_SLACK_CHANNEL=factorylm-foreman

# Optional: Comma-separated list of channels to exclude (default: cursor-enterprise)
FOREMAN_EXCLUDED_CHANNELS=cursor-enterprise

# Optional: Dry-run mode - test without launching agents (0=off, 1=on)
FOREMAN_DRY_RUN=0
