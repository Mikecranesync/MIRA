{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factorylm.com/contracts/cmms-write-contract/v1",
  "title": "FactoryLM vendor-neutral CMMS write contract v1 (#5020)",
  "description": "Language-neutral twin of mira-hub/src/lib/cmms/write-contract.ts. A provider adapter (Atlas first, in-memory mock second, Python mira-mcp adapters later) reports support per operation and per target at runtime, returns exactly one closed-set outcome per write, and never treats a legacy error dict or an empty body as success. Delivery is at-least-once with explicit deduplication on the marker; outcome_unknown is reconciled by read-back, never by a blind second write.",
  "operations": [
    "append_work_log",
    "attach_evidence",
    "record_reading",
    "transition_work_order",
    "read_work_log",
    "list_changes",
    "create_work_order"
  ],
  "support": ["implemented", "unsupported", "unknown"],
  "writeResultKinds": [
    "success",
    "accepted_pending_verification",
    "verified_by_readback",
    "unsupported",
    "permission_denied",
    "conflict",
    "retryable_failure",
    "permanent_failure",
    "outcome_unknown"
  ],
  "readBackResultKinds": ["found", "not_found", "unsupported", "error"],
  "deliveryStates": [
    "queued",
    "leased",
    "accepted_pending_verification",
    "verified_by_readback",
    "conflict",
    "unsupported",
    "permission_denied",
    "retryable_failure",
    "permanent_failure",
    "outcome_unknown",
    "quarantined",
    "blocked_policy"
  ],
  "retryableStates": ["queued", "retryable_failure", "outcome_unknown", "accepted_pending_verification"],
  "$defs": {
    "WorkOrderTarget": {
      "type": "object",
      "required": ["providerId", "externalWorkOrderId"],
      "properties": {
        "providerId": { "type": "string" },
        "externalWorkOrderId": { "type": "string" }
      }
    },
    "WorkLogNote": {
      "type": "object",
      "required": ["idempotencyKey", "marker", "text", "attributionLabel", "occurredAt", "sourceRef"],
      "properties": {
        "idempotencyKey": { "type": "string" },
        "marker": { "type": "string", "pattern": "^\\[MIRA:[0-9a-f-]{36}\\]$" },
        "text": { "type": "string" },
        "attributionLabel": { "type": "string" },
        "occurredAt": { "type": "string", "format": "date-time" },
        "sourceRef": { "type": "string", "description": "'<table>:<id>' audit reference, never a URL" }
      }
    },
    "WorkOrderRequest": {
      "type": "object",
      "required": [
        "idempotencyKey",
        "marker",
        "title",
        "description",
        "priority",
        "externalAssetId",
        "attributionLabel",
        "occurredAt",
        "sourceRef"
      ],
      "properties": {
        "idempotencyKey": { "type": "string" },
        "marker": { "type": "string", "pattern": "^\\[MIRA:[0-9a-f-]{36}\\]$" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "priority": { "type": "string" },
        "externalAssetId": { "type": ["string", "null"] },
        "attributionLabel": { "type": "string" },
        "occurredAt": { "type": "string", "format": "date-time" },
        "sourceRef": { "type": "string", "description": "'<table>:<id>' audit reference, never a URL" }
      }
    },
    "Capability": {
      "type": "object",
      "required": ["support"],
      "properties": {
        "support": { "enum": ["implemented", "unsupported", "unknown"] },
        "reason": { "type": "string" },
        "probe": { "type": "string" }
      }
    }
  },
  "atlasSupportAtDeployedDigest": {
    "backendImage": "intelloop/atlas-cmms-backend@sha256:a112fa5831f9827c92ad7d436cff8ff7bc18116be1aab3ab09639793774e49a2",
    "upstream": "github.com/Grashjs/cmms v1.8.0 (index digest; pinned for #5188 on 2026-11-05)",
    "append_work_log": "implemented — CommentController (v1.6.0+); create + read-back proven against v1.8.0 locally",
    "attach_evidence": "unsupported — POST /files/upload requires the FILE_ATTACHMENTS license entitlement (Keygen); 403 'You need a license to add a file' without one",
    "read_work_log": "implemented via POST /comments/search/{workOrderId}",
    "create_work_order": "implemented — POST /work-orders; read-back by marker via POST /work-orders/search (endpoint answers 200 on prod v1.8.0; marker read-back against a live Atlas is proven only by staging acceptance)"
  }
}
