<?xml version="1.0" encoding="utf-8"?>
<!-- #3732: legacy (pre-API 31) full-backup rules — same exclusions as
     data_extraction_rules.xml: the session cookie jar in SharedPreferences and
     the WebView stores never leave the device via adb backup or auto backup. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
