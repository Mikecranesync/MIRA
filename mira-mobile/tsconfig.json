{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "baseUrl": ".",
    "paths": {
      "@factorylm/interaction": [
        "../packages/factorylm-interaction/src/index.ts"
      ],
      "@factorylm/theme": [
        "../packages/factorylm-theme/src/index.ts"
      ],
      "@factorylm/theme/*": [
        "../packages/factorylm-theme/src/*"
      ],
      "@factorylm/ui": [
        "../packages/factorylm-ui/src/index.ts"
      ],
      "@factorylm/ui/*": [
        "../packages/factorylm-ui/src/*"
      ],
      "@assistant-ui/react": [
        "./node_modules/@assistant-ui/react"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/jsx-runtime": [
        "./node_modules/@types/react/jsx-runtime"
      ],
      "react-dom": [
        "./node_modules/@types/react-dom"
      ],
      "react-dom/*": [
        "./node_modules/@types/react-dom/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}
