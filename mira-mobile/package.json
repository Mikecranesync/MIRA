{
  "name": "mira-mobile",
  "private": true,
  "version": "0.1.0",
  "description": "FactoryLM native mobile client (ADR-0034): static Vite+React bundle in a Capacitor shell consuming Hub APIs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "sync": "npm run build && npx cap sync",
    "android": "npm run sync && npx cap run android",
    "test": "vitest run"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.17",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/share": "^8.0.1",
    "@capawesome/capacitor-file-picker": "8.0.4",
    "@capawesome/capacitor-live-update": "8.4.1",
    "qr-scanner": "^1.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "unist-util-visit": "^5.1.0",
    "yet-another-react-lightbox": "^3.32.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.10"
  }
}
