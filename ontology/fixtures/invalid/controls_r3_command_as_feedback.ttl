# EXPECT-VIOLATION: mirash:CommandNotFeedbackShape
#
# R3 — the most consequential rule in the controls module, and the reason it exists.
#
# "Run command = 1" means the PLC ASKED for run. It does not mean the shaft turned. A seized
# rotor, a tripped overload, a blown fuse and an open safety contactor ALL leave the command
# asserted and the motor still. Here MIRA claims the motor is running with nothing but the
# command bit behind it — intent presented as occurrence.
#
# read_only=true on the command signal so R13b cannot fire; this isolates R3.

@prefix mira: <https://ontology.factorylm.com/mira#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <https://example.org/fx#> .

ex:plc     a mira:SourceDocument .
ex:tag_src a mira:Citation ; mira:cite_doc ex:plc ; mira:cite_locator "enterprise.site.line.cv101.run_cmd" .
ex:run_cmd a mira:CommandSignal ; mira:read_only true .

ex:obs_cmd a mira:Observation ;
    mira:observed_signal ex:run_cmd ;
    mira:value true ;
    mira:value_type mira:valuetype_bool ;
    mira:event_timestamp "2026-07-26T14:03:00Z"^^xsd:dateTime ;
    mira:clock_source mira:clock_plc ;
    mira:quality mira:quality_good ;
    mira:freshness mira:freshness_live ;
    mira:supported_by ex:tag_src .

ex:claim_running a mira:PhysicalStateClaim ;
    mira:predicate "motor_is_running" ;
    mira:supported_by ex:obs_cmd .
