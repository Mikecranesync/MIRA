# EXPECT-VIOLATION: mirash:InvalidatedNotCurrentShape
#
# R14b — contradicting evidence arrived and invalidated the claim, but it is still exposed as
# current. Distinct from R14a: supersession replaces a claim, invalidation refutes it.
#
# Isolation: the invalidated assertion is at approval_state=rejected, and nothing supersedes it,
# so neither R14a nor R14c can fire.

@prefix mira: <https://ontology.factorylm.com/mira#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <https://example.org/fx#> .

ex:tech1  a mira:Technician .
ex:llm    a mira:SoftwareAgent .
ex:doc1   a mira:SourceDocument .
ex:cite1  a mira:Citation ; mira:cite_doc ex:doc1 ; mira:cite_locator "p.114" .

ex:a_wrong a mira:Assertion ;
    mira:subject ex:cv101 ; mira:predicate "has_component" ; mira:object ex:mtr3 ;
    mira:approval_state mira:approval_rejected ;
    mira:exposed_as_current true .

ex:a_contradicting a mira:Assertion ;
    mira:subject ex:cv101 ; mira:predicate "has_component" ; mira:object ex:mtr9 ;
    mira:invalidates ex:a_wrong ;
    mira:approval_state mira:approval_verified ;
    mira:supported_by ex:cite1 ;
    mira:proposed_by ex:llm ;
    mira:approved_by ex:tech1 ;
    mira:approved_at "2026-07-21T09:15:00Z"^^xsd:dateTime .
