# EXPECT-VIOLATION: mirash:FaultAppliedToWrongFamilyShape
#
# R4c. The same wrong-family attribution as drives_r4c_other_familys_fault_on_this_drive, stated
# from the fault code's side: the PowerFlex 40 code says it is a fault_of the GS10 drive. fault_of is
# the declared inverse of has_fault, so the direction it was written in must not decide whether a
# wrong-machine answer is caught.

@prefix mira: <https://ontology.factorylm.com/mira#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <https://example.org/fx#> .

ex:automationdirect a mira:Manufacturer .
ex:rockwell         a mira:Manufacturer .
ex:gs10 a mira:DriveFamily ; mira:manufactured_by ex:automationdirect .
ex:pf40 a mira:DriveFamily ; mira:manufactured_by ex:rockwell .
ex:manual a mira:SourceDocument .
ex:cite   a mira:Citation ; mira:cite_doc ex:manual ; mira:cite_locator "p.114" .
ex:vfd_101 a mira:AssetInstance ; mira:member_of_family ex:gs10 .
ex:f007_pf40 a mira:FaultCode ; mira:fault_mnemonic "F007" ; mira:scoped_to ex:pf40 ;
             mira:supported_by ex:cite ; mira:fault_of ex:vfd_101 .
