# PROTECTS: mirash:ConductorEndpointsShape
#
# R6, second legitimate form: one end read, the gap recorded with endpoint_unresolved=true.

@prefix mira: <https://ontology.factorylm.com/mira#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <https://example.org/fx#> .

ex:x1_3 a mira:ConnectionPoint ; mira:terminal_label "X1:3" .
ex:w101 a mira:Conductor ; mira:wire_number "101" ; mira:terminates_at ex:x1_3 ;
        mira:endpoint_unresolved true .
