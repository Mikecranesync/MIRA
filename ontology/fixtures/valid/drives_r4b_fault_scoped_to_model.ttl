# PROTECTS: mirash:FaultCodeScopeTargetShape
#
# R4b. The second legitimate scope: a specific DriveModel (the seed fixture covers a DriveFamily).

@prefix mira: <https://ontology.factorylm.com/mira#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <https://example.org/fx#> .

ex:manual a mira:SourceDocument .
ex:cite   a mira:Citation ; mira:cite_doc ex:manual ; mira:cite_locator "p.114" .
ex:gs10_2p0 a mira:DriveModel .
ex:f007 a mira:FaultCode ; mira:fault_mnemonic "F007" ; mira:scoped_to ex:gs10_2p0 ;
        mira:supported_by ex:cite .
