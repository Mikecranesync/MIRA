# PROTECTS: mirash:SelfParentShape
#
# R11a. Parent and child are different nodes, stated from both ends.

@prefix mira: <https://ontology.factorylm.com/mira#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <https://example.org/fx#> .

ex:line_1 a mira:Line     ; mira:has_child ex:cell_1 .
ex:cell_1 a mira:WorkCell ; mira:has_parent ex:line_1 .
