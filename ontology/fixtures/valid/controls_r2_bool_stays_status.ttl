# R2 satisfied — the boolean lives on a StatusSignal (a FeedbackSignal that is not a
# MeasurementSignal), where a bool is exactly right. No quantity_kind is claimed for it.
# The measurement alongside it is numeric, as a measurement must be.

@prefix mira: <https://ontology.factorylm.com/mira#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <https://example.org/fx#> .

ex:plc     a mira:SourceDocument .
ex:tag_src a mira:Citation ; mira:cite_doc ex:plc ; mira:cite_locator "enterprise.site.line.cv101.dc_bus" .
ex:run_status a mira:StatusSignal .
ex:speed_hz   a mira:MeasurementSignal ; mira:quantity_kind mira:qk_frequency .

ex:obs_status a mira:Observation ;
    mira:observed_signal ex:run_status ;
    mira:value true ;
    mira:value_type mira:valuetype_bool ;
    mira:event_timestamp "2026-07-26T14:03:00Z"^^xsd:dateTime ;
    mira:clock_source mira:clock_plc ;
    mira:quality mira:quality_good ;
    mira:freshness mira:freshness_live ;
    mira:supported_by ex:tag_src .

ex:obs_speed a mira:Observation ;
    mira:observed_signal ex:speed_hz ;
    mira:value 47.5 ;
    mira:value_type mira:valuetype_float ;
    mira:quantity_kind mira:qk_frequency ;
    mira:unit "Hz" ;
    mira:event_timestamp "2026-07-26T14:03:00Z"^^xsd:dateTime ;
    mira:clock_source mira:clock_plc ;
    mira:quality mira:quality_good ;
    mira:freshness mira:freshness_live ;
    mira:supported_by ex:tag_src .
