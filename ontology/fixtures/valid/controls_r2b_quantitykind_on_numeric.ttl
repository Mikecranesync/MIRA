# R2b satisfied — the signal declaring a quantity_kind is observed as a float, not a bool.

@prefix mira: <https://ontology.factorylm.com/mira#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <https://example.org/fx#> .

ex:plc     a mira:SourceDocument .
ex:tag_src a mira:Citation ; mira:cite_doc ex:plc ; mira:cite_locator "enterprise.site.line.cv101.dc_bus" .
ex:current_a a mira:MeasurementSignal ; mira:quantity_kind mira:qk_current .

ex:obs_r2b_ok a mira:Observation ;
    mira:observed_signal ex:current_a ;
    mira:value 12.4 ;
    mira:value_type mira:valuetype_float ;
    mira:quantity_kind mira:qk_current ;
    mira:unit "A" ;
    mira:event_timestamp "2026-07-26T14:03:00Z"^^xsd:dateTime ;
    mira:clock_source mira:clock_plc ;
    mira:quality mira:quality_good ;
    mira:freshness mira:freshness_live ;
    mira:supported_by ex:tag_src .
