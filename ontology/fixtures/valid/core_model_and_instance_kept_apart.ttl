# PROTECTS: mirash:AssetClassInstanceShape
#
# The legitimate shape of the same fact: the model is one node, the drive on the conveyor is
# another, and instance_of links them.

@prefix mira: <https://ontology.factorylm.com/mira#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <https://example.org/fx#> .

ex:gs10_2p0 a mira:AssetClass .
ex:vfd_101  a mira:AssetInstance ; mira:instance_of ex:gs10_2p0 ;
            mira:uns_path "enterprise.garage.demo_cell.cv_101.vfd_101" .
