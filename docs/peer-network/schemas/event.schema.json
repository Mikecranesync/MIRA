{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factorylm.com/schemas/peer-network/1.2.0/event.schema.json",
  "title": "peer-network event",
  "version": "1.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "idempotency_key",
    "ts",
    "kind",
    "mission_id",
    "session_uuid",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,}$"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,}$"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "kind": {
      "type": "string",
      "enum": [
        "join_network",
        "heartbeat",
        "fleet_status",
        "request_work",
        "claim_work",
        "renew_claim",
        "release_claim",
        "submit_checkpoint",
        "request_handoff",
        "accept_handoff",
        "submit_result",
        "request_review",
        "submit_verdict",
        "leave_network",
        "human_gate",
        "commit",
        "release"
      ]
    },
    "mission_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z0-9-]+$",
      "description": "Fail-closed: a string value must match the pattern (empty or free text is rejected); null only where the operation is mission-less."
    },
    "session_uuid": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,}$"
    },
    "payload": {
      "type": "object",
      "description": "Per-kind proof: sha-bearing kinds (commit, request_review, submit_verdict, submit_result) must carry a 40-hex sha (laws 8\u20139); submit_verdict also a verdict; human_gate a gate kind and decided_by; accept_handoff the claim generation. A field that carries an authority claim needs a pattern or an enum, not prose."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "commit",
              "request_review"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "sha"
            ],
            "properties": {
              "sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "submit_verdict"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "sha",
              "verdict"
            ],
            "properties": {
              "sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "verdict": {
                "type": "string",
                "enum": [
                  "PASS",
                  "FAIL",
                  "HOLD",
                  "UNDECIDABLE"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "submit_result"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "sha"
            ],
            "properties": {
              "sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "human_gate"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "gate",
              "decided_by"
            ],
            "properties": {
              "gate": {
                "type": "string",
                "enum": [
                  "merge",
                  "deploy_production",
                  "architecture",
                  "secret",
                  "protected_infrastructure",
                  "physical_test"
                ]
              },
              "decided_by": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "accept_handoff"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "generation"
            ],
            "properties": {
              "generation": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "join_network"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "node_id",
              "capabilities"
            ],
            "properties": {
              "node_id": {
                "type": "string",
                "enum": [
                  "alpha",
                  "bravo",
                  "charlie",
                  "travel",
                  "plc",
                  "vps"
                ]
              },
              "capabilities": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "enum": [
                    "bash",
                    "git",
                    "gh",
                    "write",
                    "worktree",
                    "codex-cli",
                    "adb",
                    "bun",
                    "docker",
                    "plc",
                    "ignition",
                    "factory-io",
                    "read-only"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "heartbeat"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "lease_expires_at"
            ],
            "properties": {
              "lease_expires_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "fleet_status"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "nodes"
            ],
            "properties": {
              "nodes": {
                "type": "array"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "request_work"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "capabilities"
            ],
            "properties": {
              "capabilities": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "enum": [
                    "bash",
                    "git",
                    "gh",
                    "write",
                    "worktree",
                    "codex-cli",
                    "adb",
                    "bun",
                    "docker",
                    "plc",
                    "ignition",
                    "factory-io",
                    "read-only"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "claim_work"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "resource_keys",
              "base_sha",
              "branch"
            ],
            "properties": {
              "resource_keys": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^(packages/[a-z0-9-]+|apps/[a-z0-9-]+|mira-[a-z-]+|migration:next|device:[a-z0-9-]+|environment:(dev|staging|prod)|docs/(?!(?:.*/)?\\.{1,2}(?:/|$))[A-Za-z0-9_./-]+|deployment/(?!(?:.*/)?\\.{1,2}(?:/|$))[A-Za-z0-9_./-]+|tests/(?!(?:.*/)?\\.{1,2}(?:/|$))[A-Za-z0-9_./-]+|\\.github/workflows/(?!(?:.*/)?\\.{1,2}(?:/|$))[A-Za-z0-9_./-]+\\.ya?ml|root:(CLAUDE\\.md|AGENTS\\.md))$"
                }
              },
              "base_sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "branch": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "renew_claim"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "lease_expires_at",
              "generation"
            ],
            "properties": {
              "lease_expires_at": {
                "type": "string",
                "format": "date-time"
              },
              "generation": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "release_claim"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "RELEASED",
                  "COMPLETE"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "submit_checkpoint"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "sha"
            ],
            "properties": {
              "sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "request_handoff"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "handoff_ref"
            ],
            "properties": {
              "handoff_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "leave_network"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "release"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "version",
              "sha"
            ],
            "properties": {
              "version": {
                "type": "string",
                "pattern": "^v?\\d+\\.\\d+\\.\\d+$"
              },
              "sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        }
      }
    }
  ]
}
