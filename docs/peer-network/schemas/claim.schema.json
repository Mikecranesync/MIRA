{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factorylm.com/schemas/peer-network/1.1.0/claim.schema.json",
  "title": "peer-network claim",
  "version": "1.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mission_id",
    "session_uuid",
    "base_sha",
    "branch",
    "worktree",
    "resource_keys",
    "lease_expires_at",
    "generation",
    "status",
    "claimed_at"
  ],
  "properties": {
    "mission_id": {
      "type": "string"
    },
    "session_uuid": {
      "type": "string"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "branch": {
      "type": "string"
    },
    "worktree": {
      "type": "string"
    },
    "resource_keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(packages/[a-z0-9-]+|apps/[a-z0-9-]+|mira-[a-z-]+|migration:next|device:[a-z0-9-]+|environment:(dev|staging|prod)|docs/[A-Za-z0-9_./-]+|deployment/[A-Za-z0-9_./-]+|root:(CLAUDE\\.md|AGENTS\\.md))$"
      },
      "description": "Canonical resource keys acquired atomically \u2014 all or none (PRD \u00a77)."
    },
    "lease_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "LEASE_AT_RISK",
        "RELEASED",
        "COMPLETE"
      ],
      "description": "Lifecycle of the lease. ACTIVE = held; LEASE_AT_RISK = renewal missed, stop before the next edit/push; RELEASED = given up (lost the race, handed back, stale takeover); COMPLETE = work delivered and claims released (law 5)."
    },
    "claimed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the claim was made. 'Earliest ACTIVE claim wins' orders by THIS field; the GitHub comment timestamp is only a tiebreak, because editing a comment keeps its creation time."
    }
  }
}
