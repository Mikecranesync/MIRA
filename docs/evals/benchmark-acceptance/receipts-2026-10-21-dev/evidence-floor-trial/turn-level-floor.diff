+/** Evidence-sufficiency floor for the V2 lexical lane (default off). A candidate must
+ *  cover at least this share of the question's IDF mass; a question lexeme absent from
+ *  the scope counts at the maximum IDF, so a question whose distinguishing words the
+ *  manual never uses finds no candidate and the turn takes the existing no-coverage
+ *  path. Unset, empty, or outside (0, 1) → null (no floor). */
+export function lexicalV2MinCoverage(): number | null {
+  const raw = (process.env.NOTEBOOK_LEXICAL_V2_MIN_COVERAGE ?? "").trim();
+  if (!raw) return null;
+  const v = Number(raw);
+  return Number.isFinite(v) && v > 0 && v < 1 ? v : null;
+}
