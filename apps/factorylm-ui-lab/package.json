{
  "name": "factorylm-ui-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.tsx",
    "build": "tsc --noEmit",
    "preview": "bun src/main.tsx",
    "test": "bun test ../../packages",
    "test:watch": "bun test --watch ../../packages",
    "test:e2e": "bunx playwright test",
    "licenses": "bun scripts/check-dependency-licenses.ts",
    "verify": "bun run test && bun run build && bun run licenses"
  },
  "dependencies": {
    "@factorylm/interaction": "file:../../packages/factorylm-interaction",
    "@factorylm/theme": "file:../../packages/factorylm-theme",
    "@factorylm/ui": "file:../../packages/factorylm-ui",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/bun": "1.3.10",
    "playwright": "1.59.1",
    "typescript": "5.7.2"
  }
}
