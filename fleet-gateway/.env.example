# Fleet Gateway MCP v1 — placeholders only. Copy to .env locally.
# NEVER commit a real token. FLEET_GATEWAY_BEARER is required at runtime.

FLEET_GATEWAY_BEARER=change-me-to-a-long-random-token

# --- CAO endpoints ----------------------------------------------------------
# Every URL MUST be loopback 127.0.0.1; localhost/::1/LAN/Tailscale are refused.
# A REMOTE node is reached by pointing its per-role URL at a LOCAL forwarded port
# (e.g. an SSH -L tunnel), never by exposing that node's CAO.
# Agent profile mapping (no local bravo/charlie CAO profiles):
#   bravo → developer,  charlie → reviewer  (CAO built-in profiles)
#   provider: claude → claude_code,  codex → codex
#
# 1) Unset everything      → in-process FakeCAO stub (tests, local dev).
# 2) FLEET_GATEWAY_CAO_URL → ONE CAO for every role (original v1 behavior).
# 3) …_CAO_URL_<ROLE>      → per-node routing; role selects the node.
#
# WARNING: with only FLEET_GATEWAY_CAO_URL set, `role` is just an agent-profile
# label — ALL roles hit that one CAO (#3552). Pointing it at a tunnelled remote
# port does not "add" that node, it REPLACES the local one. Use the per-role vars.
#
# Per-node routing (one per role in contract.ALLOWED_ROLES):
# FLEET_GATEWAY_CAO_URL_BRAVO=http://127.0.0.1:9889     # Bravo's own local CAO
# FLEET_GATEWAY_CAO_URL_CHARLIE=http://127.0.0.1:19889  # Charlie via SSH -L tunnel
#
# Optional fallback for roles with no per-role URL. If a role is neither mapped
# nor covered by this, the gateway FAILS CLOSED rather than reaching another
# node's CAO.
# FLEET_GATEWAY_CAO_URL=http://127.0.0.1:18765

# Artifact + audit directory (gitignored)
# FLEET_GATEWAY_DATA_DIR=./var

# HTTP bind — default loopback. Public HTTPS is a later Mike-approved step.
FLEET_GATEWAY_HOST=127.0.0.1
FLEET_GATEWAY_PORT=8765

# Isolated worktree source (defaults shown). Gateway never deletes worktrees.
# FLEET_GATEWAY_REPO=/Users/bravonode/Mira
# FLEET_GATEWAY_WORKTREE_PARENT=/Users/bravonode/Mira-worktrees

