# Fleet Gateway MCP v1 — placeholders only. Copy to .env locally.
# NEVER commit a real token. FLEET_GATEWAY_BEARER is required at runtime.

FLEET_GATEWAY_BEARER=change-me-to-a-long-random-token

# Leave unset to use the in-process FakeCAO stub (default, tests, local dev without cao-server).
# If set, MUST point to an existing colocated loopback cao-server; non-127.0.0.1 is refused.
# Public CAO exposure is a later Mike-approved tunnel/VPS step, not v1.
# Agent profile mapping (no local bravo/charlie CAO profiles):
#   bravo → developer,  charlie → reviewer  (CAO built-in profiles)
#   provider: claude → claude_code,  codex → codex
# FLEET_GATEWAY_CAO_URL=http://127.0.0.1:18765

# Artifact + audit directory (gitignored)
# FLEET_GATEWAY_DATA_DIR=./var

# HTTP bind — default loopback. Public HTTPS is a later Mike-approved step.
FLEET_GATEWAY_HOST=127.0.0.1
FLEET_GATEWAY_PORT=8765

# Retention bound for Gateway-created `fleet-e2e-*` worktrees (#3546). Each one
# is ~561 MB and nothing else ever removes them; before this bound existed they
# filled Charlie's disk to 100%. The sweep runs at create time, clears only the
# Gateway's own artifact files, then uses `git worktree remove` WITHOUT --force
# so git refuses on anything holding real work. 0 disables it.
# FLEET_GATEWAY_WORKTREE_RETAIN=12

# Isolated worktree source (defaults shown). No Gateway TOOL can delete a
# worktree (`delete_worktree` is hard-denied); the bound above is internal.
# FLEET_GATEWAY_REPO=/Users/bravonode/Mira
# FLEET_GATEWAY_WORKTREE_PARENT=/Users/bravonode/Mira-worktrees

