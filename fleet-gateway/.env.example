# Fleet Gateway MCP v1 — placeholders only. Copy to .env locally.
# NEVER commit a real token. FLEET_GATEWAY_BEARER is required at runtime.

FLEET_GATEWAY_BEARER=change-me-to-a-long-random-token

# Per-role CAO loopback endpoints.
# Bravo may use the legacy FLEET_GATEWAY_CAO_URL fallback below.
# Charlie MUST use FLEET_GATEWAY_CHARLIE_CAO_URL; it never falls back to Bravo CAO.
# If set, each URL MUST point to an existing colocated loopback cao-server;
# non-127.0.0.1 is refused. Public CAO exposure is not v1.
# Agent profile mapping (no local bravo/charlie CAO profiles):
#   bravo → developer,  charlie → reviewer  (CAO built-in profiles)
#   provider: claude → claude_code,  codex → codex
# FLEET_GATEWAY_BRAVO_CAO_URL=http://127.0.0.1:18765
# FLEET_GATEWAY_CHARLIE_CAO_URL=http://127.0.0.1:18766

# Legacy Bravo-only CAO URL. Kept for existing Bravo setups; ignored for Charlie.
# FLEET_GATEWAY_CAO_URL=http://127.0.0.1:18765

# Artifact + audit directory (gitignored)
# FLEET_GATEWAY_DATA_DIR=./var

# HTTP bind — default loopback. Public HTTPS is a later Mike-approved step.
FLEET_GATEWAY_HOST=127.0.0.1
FLEET_GATEWAY_PORT=8765

# Isolated worktree sources (defaults shown). Gateway never deletes worktrees.
# Bravo defaults:
# FLEET_GATEWAY_REPO=/Users/bravonode/Mira
# FLEET_GATEWAY_WORKTREE_PARENT=/Users/bravonode/Mira-worktrees
# FLEET_GATEWAY_BRAVO_REPO=/Users/bravonode/Mira
# FLEET_GATEWAY_BRAVO_WORKTREE_PARENT=/Users/bravonode/Mira-worktrees
# FLEET_GATEWAY_BRAVO_EXPECTED_HOSTNAME=FactoryLM-Bravo.local

# Charlie defaults. Configure only on the Charlie physical node; no tunnels here.
# Charlie launch fails closed if hostname, CAO health, repo path, or worktree path
# do not match Charlie identity.
# FLEET_GATEWAY_CHARLIE_REPO=/Users/charlienode/Mira
# FLEET_GATEWAY_CHARLIE_WORKTREE_PARENT=/Users/charlienode/Mira-worktrees
# FLEET_GATEWAY_CHARLIE_EXPECTED_HOSTNAME=CharlieNodes-Mac-mini.local
