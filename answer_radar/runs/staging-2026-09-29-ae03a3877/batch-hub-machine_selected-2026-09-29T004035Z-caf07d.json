    "frozen_snapshot": "/Users/charlienode/MIRA/.claude/worktrees/rebench/answer_radar/runs/staging-2026-09-29-ae03a3877/frozen/FIELD-SEED-001.frozen.json",
    "evaluation": {
      "question_id": "FIELD-SEED-001",
