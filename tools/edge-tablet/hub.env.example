# ~/hub.env on the tablet — the MIRA Hub's settings for the offline (edge) profile.
# Copy to ~/hub.env in Termux, fill in the two <...> values, chmod 600.
# MIRA_PROFILE=edge makes the Hub refuse to start with any cloud credential set or any
# listed endpoint off this device, and blocks every non-loopback connection at runtime.
# Do NOT add API keys (GROQ_API_KEY, OPENAI_API_KEY, ...): the Hub will refuse to start.
export NODE_ENV=production
export PORT=3000
export HOSTNAME=127.0.0.1
export MIRA_PROFILE=edge
# Local Postgres (port 5433, TLS with the device's own certificate).
export NEON_DATABASE_URL="postgresql://mira:<db-password>@127.0.0.1:5433/mira_edge?sslmode=require"
export NODE_EXTRA_CA_CERTS=$HOME/pgdata/server.crt
# Session signing key, unique per device: openssl rand -base64 32
export AUTH_SECRET=<random-32-bytes-base64>
export NEXTAUTH_URL=http://127.0.0.1:3000
export NEXT_TELEMETRY_DISABLED=1
# Lanes that have a cloud default are switched off on the device ("" or a dead loopback port).
export MIRA_ASK_URL=
export HUB_CMMS_API_URL=
export NANGO_SERVER_URL=
export OTA_ORIGIN=http://127.0.0.1:1
export NOTEBOOK_LIVING_SHEET=1
# Written by install.sh / rollback.sh.
export MIRA_GIT_SHA=unset
export MIRA_APP_VERSION=edge
# Evidence-only fault mode (#5304) stays OFF until the owner approves it. Do not set it here.
# export MIRA_EDGE_EVIDENCE_ONLY_FAULTS=1
